{
  "name": "serv",
  "version": "0.2.0",
  "description": "A tiny local web server that renders Markdown and serves everything else as-is.",
  "type": "module",
  "bin": {
    "serv": "src/cli.ts"
  },
  "files": [
    "src",
    "THIRD_PARTY_NOTICES.md",
    "!src/*.test.ts",
    "!src/styles.input.css"
  ],
  "engines": {
    "bun": ">=1.3.8"
  },
  "scripts": {
    "test": "bun test",
    "start": "bun run src/cli.ts",
    "build:css": "tailwindcss -i ./src/styles.input.css -o ./src/styles.css --minify",
    "build:search": "bun build src/search.ts --minify --target=browser --format=esm --outfile=src/search.bundle.js",
    "build": "bun run build:css && bun run build:search"
  },
  "keywords": [
    "bun",
    "markdown",
    "server",
    "static",
    "preview"
  ],
  "license": "MIT",
  "author": "Yuxi Wang",
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@types/bun": "1.4.5",
    "fzf": "0.5.2",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "shiki": "4.6.0"
  }
}
